# Render RELAUNCH_SERVER_NAME during host configuration. This is deliberately
# a placeholder: this template neither configures DNS nor terminates TLS.
server {
    listen 80;
    server_name ${RELAUNCH_SERVER_NAME};

    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
