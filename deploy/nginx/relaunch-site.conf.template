# Render only the RELAUNCH_* placeholders during host configuration. This file
# records the dedicated ReLaunch vhost; it does not configure DNS or issue a
# certificate.
server {
    listen 80;
    server_name ${RELAUNCH_SERVER_NAME};

    root ${RELAUNCH_ACME_ROOT};

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    access_log /www/wwwlogs/${RELAUNCH_SERVER_NAME}.log;
    error_log /www/wwwlogs/${RELAUNCH_SERVER_NAME}.error.log;
}

server {
    listen 443 ssl http2;
    server_name ${RELAUNCH_SERVER_NAME};

    ssl_certificate ${RELAUNCH_CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${RELAUNCH_CERT_DIR}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RELAUNCH_SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    access_log /www/wwwlogs/${RELAUNCH_SERVER_NAME}.log;
    error_log /www/wwwlogs/${RELAUNCH_SERVER_NAME}.error.log;
}
